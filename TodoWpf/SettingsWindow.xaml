<Window x:Class="TodoWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoWpf.ViewModels"
        Title="설정"
        Width="420"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="설정"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1"
                    Margin="0,20,0,0">
            <TextBlock Text="시작 필터"
           Margin="0,0,0,8"/>

            <ComboBox SelectedValue="{Binding DefaultFilter}"
                      SelectedValuePath="Tag"
                      Margin="0,0,0,16">
                <ComboBoxItem Content="전체"
                  Tag="{x:Static vm:TodoFilter.All}"/>
                <ComboBoxItem Content="진행 중"
                  Tag="{x:Static vm:TodoFilter.Active}"/>
                <ComboBoxItem Content="완료"
                  Tag="{x:Static vm:TodoFilter.Completed}"/>
            </ComboBox>

            <CheckBox Content="검색어 기억"
                      IsChecked="{Binding RememberSearchText}"/>

            <TextBox Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding RememberSearchText}"
                     Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="저장"
                    Style="{StaticResource SmallButtonStyle}"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"
                    Click="SaveButton_Click"/>

            <Button Content="취소"
                    Style="{StaticResource SmallButtonStyle}"
                    Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>