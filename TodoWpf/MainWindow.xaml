<Window x:Class="TodoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TodoWpf.Models"
        Title="WPF 할 일 관리"
        Width="560"
        Height="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="24"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="NewTodoTitleTextBox"
                     Grid.Column="0"
                     Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding NewTodoTitle,
                                    UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1"
                    Style="{StaticResource AddButtonStyle}"
                    Content="추가"
                    IsDefault="True"
                    Command="{Binding AddTodoCommand}"
                    Click="AddButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource ErrorTextBlockStyle}"
                   Text="{Binding NewTodoTitleErrorMessage}"/>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Orientation="Horizontal">
                <Button Content="전체"
                        Margin="0,0,8,0"
                        Style="{StaticResource AllFilterButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="{x:Static models:TodoFilter.All}"/>

                <Button Content="진행 중"
                        Margin="0,0,8,0"
                        Style="{StaticResource ActiveFilterButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="{x:Static models:TodoFilter.Active}"/>

                <Button Content="완료"
                        Style="{StaticResource CompletedFilterButtonStyle}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="{x:Static models:TodoFilter.Completed}"/>
            </StackPanel>

            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      Width="120"
                      Background="{DynamicResource InputBackgroundBrush}"
                      BorderBrush="{DynamicResource InputBorderBrush}"
                      Foreground="{DynamicResource InputForegroundBrush}"
                      SelectedValue="{Binding SelectedSort, Mode=TwoWay}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="최신순"
                              Tag="{x:Static models:TodoSortOption.NewestFirst}"/>
                <ComboBoxItem Content="오래된순"
                              Tag="{x:Static models:TodoSortOption.OldestFirst}"/>
                <ComboBoxItem Content="제목순"
                              Tag="{x:Static models:TodoSortOption.TitleAscending}"/>
                <ComboBoxItem Content="미완료순"
                              Tag="{x:Static models:TodoSortOption.IncompleteFirst}"/>
            </ComboBox>

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
                <Button Content="완료 항목 삭제"
                        Margin="0,0,8,0"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding ClearCompletedCommand}"/>

                <Button Content="전체 삭제"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding ClearAllCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchTextBox_KeyDown"
                     Height="36"
                     Margin="0,0,8,0"
                     VerticalAlignment="Top"/>

            <Button Grid.Column="1"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="X"
                    Command="{Binding ClearSearchCommand}"/>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0,12,0,0"
              Style="{StaticResource EditPanelStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EditTodoTitleTextBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding EditTodoTitle,
                                    UpdateSourceTrigger=PropertyChanged}"
                     IsVisibleChanged="EditTodoTitleTextBox_IsVisibleChanged"
                     KeyDown="EditTodoTitleTextBox_KeyDown"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="저장"
                    Command="{Binding SaveEditCommand}"/>

            <Button Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="취소"
                    Command="{Binding CancelEditCommand}"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource ErrorTextBlockStyle}"
                       Text="{Binding EditTodoTitleErrorMessage}"/>
        </Grid>

        <ListBox Grid.Row="5"
                 Margin="0,16"
                 ItemsSource="{Binding TodosView}"
                 ItemContainerStyle="{StaticResource TodoListBoxItemStyle}"
                 ItemTemplate="{StaticResource TodoItemTemplate}"/>

        <Grid Grid.Row="6">
            <TextBlock Foreground="Gray"
               Text="내용을 입력한 후 Enter를 눌러도 추가됩니다."
               VerticalAlignment="Center"/>

            <Button Content="설정"
            Style="{StaticResource SmallButtonStyle}"
            HorizontalAlignment="Right"
            Click="SettingsButton_Click"/>
        </Grid>
    </Grid>
</Window>
