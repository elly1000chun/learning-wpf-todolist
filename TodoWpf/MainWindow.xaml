<Window x:Class="TodoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoWpf.ViewModels"
        Title="WPF 할 일 관리"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding NewTodoTitle,
                UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="1"
                    Style="{StaticResource AddButtonStyle}"
                    Content="추가"
                    IsDefault="True"
                    Command="{Binding AddTodoCommand}"/>
        </Grid>


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button Content="전체"
                    Margin="0,0,8,0"
                    Style="{StaticResource AllFilterButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:TodoFilter.All}"/>

            <Button Content="진행 중"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActiveFilterButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:TodoFilter.Active}"/>

            <Button Content="완료"
                    Style="{StaticResource CompletedFilterButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:TodoFilter.Completed}"/>
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding SearchText,
                UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="1"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="X"
                    Command="{Binding ClearSearchCommand}"/>
        </Grid>

        <ListBox Grid.Row="3"
                 Margin="0,16"
                 ItemsSource="{Binding TodosView}"
                 ItemContainerStyle="{StaticResource TodoListBoxItemStyle}"
                 ItemTemplate="{StaticResource TodoItemTemplate}"/>

        <TextBlock Grid.Row="4"
                   Foreground="Gray"
                   Text="내용을 입력한 후 Enter를 눌러도 추가됩니다."/>
    </Grid>
</Window>
