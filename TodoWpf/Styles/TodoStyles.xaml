<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TodoWpf.ViewModels">

    <Style x:Key="TodoTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#222222"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter Property="Foreground" Value="Gray"/>
                <Setter Property="TextDecorations" Value="Strikethrough"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="FilterButtonBaseStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    
    <Style x:Key="AllFilterButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource FilterButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedFilter}"
                         Value="{x:Static vm:TodoFilter.All}">
                <Setter Property="Background" Value="#DDEBFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActiveFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilterButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedFilter}"
                         Value="{x:Static vm:TodoFilter.Active}">
                <Setter Property="Background" Value="#DDEBFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompletedFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilterButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedFilter}"
                         Value="{x:Static vm:TodoFilter.Completed}">
                <Setter Property="Background" Value="#DDEBFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="TodoListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style x:Key="AddButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="18,7"/>
    </Style>

    <Style x:Key="SmallButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,5"/>
    </Style>

    <Style x:Key="DeleteButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="EditPanelStyle" TargetType="Grid">
        <Setter Property="Visibility" Value="Visible"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding EditingTodo}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TodoItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Margin="4,0,10,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsDone}"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       Style="{StaticResource TodoTitleTextBlockStyle}"/>
            <Button Grid.Column="2"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="수정"
                    Command="{Binding DataContext.StartEditCommand,
                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding}"/>
            <Button Grid.Column="3"
                    Style="{StaticResource DeleteButtonStyle}"
                    Content="삭제"
                    Command="{Binding DataContext.RemoveTodoCommand,
                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>