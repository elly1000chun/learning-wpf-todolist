<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:TodoWpf.Models">

    <Thickness x:Key="InputTextBoxMargin">0,0,8,0</Thickness>
    <Thickness x:Key="InputTextBoxPadding">10,7</Thickness>
    <Thickness x:Key="FilterButtonPadding">12,5</Thickness>
    <Thickness x:Key="SmallButtonPadding">12,5</Thickness>
    <Thickness x:Key="AddButtonPadding">18,7</Thickness>
    <Thickness x:Key="DeleteButtonPadding">10,4</Thickness>
    <Thickness x:Key="TodoItemPadding">4</Thickness>
    <Thickness x:Key="TodoCheckBoxMargin">4,0,10,0</Thickness>

    <Style x:Key="TodoTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="TextDecorations" Value="Strikethrough"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TodoMetadataTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

    <Style x:Key="TodoUpdatedAtTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TodoMetadataTextBlockStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding UpdatedAt}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TodoDueDateTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TodoMetadataTextBlockStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Margin" Value="{StaticResource InputTextBoxMargin}"/>
        <Setter Property="Padding" Value="{StaticResource InputTextBoxPadding}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
    </Style>

    <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InputDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ErrorTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DeleteButtonForegroundBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Visibility" Value="Visible"/>

        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HelpTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EmptyStateTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource HelpTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Visibility" Value="Collapsed"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding HasNoVisibleTodos}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterButtonBaseStyle" TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource FilterButtonPadding}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    
    <Style x:Key="AllFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilterButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedFilter}"
                         Value="{x:Static models:TodoFilter.All}">
                <Setter Property="Background" Value="{DynamicResource SelectedFilterButtonBackgroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActiveFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilterButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedFilter}"
                         Value="{x:Static models:TodoFilter.Active}">
                <Setter Property="Background" Value="{DynamicResource SelectedFilterButtonBackgroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompletedFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilterButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedFilter}"
                         Value="{x:Static models:TodoFilter.Completed}">
                <Setter Property="Background" Value="{DynamicResource SelectedFilterButtonBackgroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="TodoListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="{StaticResource TodoItemPadding}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    </Style>

    <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
    </Style>

    <Style x:Key="AddButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonBaseStyle}">
        <Setter Property="Padding" Value="{StaticResource AddButtonPadding}"/>
    </Style>

    <Style x:Key="SmallButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonBaseStyle}">
        <Setter Property="Padding" Value="{StaticResource SmallButtonPadding}"/>
    </Style>

    <Style x:Key="DeleteButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonBaseStyle}">
        <Setter Property="Padding" Value="{StaticResource DeleteButtonPadding}"/>
        <Setter Property="Foreground" Value="{DynamicResource DeleteButtonForegroundBrush}"/>
    </Style>

    <Style x:Key="EditPanelStyle" TargetType="Grid">
        <Setter Property="Visibility" Value="Visible"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding EditingTodo}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TodoItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Margin="{StaticResource TodoCheckBoxMargin}"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsDone}"/>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource TodoTitleTextBlockStyle}"/>

                <TextBlock Text="{Binding CreatedAt, StringFormat=작성일: {0:yyyy-MM-dd HH:mm}}"
                           Style="{StaticResource TodoMetadataTextBlockStyle}"/>

                <TextBlock Text="{Binding UpdatedAt, StringFormat=수정일: {0:yyyy-MM-dd HH:mm}}"
                           Style="{StaticResource TodoUpdatedAtTextBlockStyle}"/>

                <TextBlock Text="{Binding DueDate, StringFormat=마감일: {0:yyyy-MM-dd}}"
                           Style="{StaticResource TodoDueDateTextBlockStyle}"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="수정"
                    Command="{Binding DataContext.StartEditCommand,
                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding}"/>
            <Button Grid.Column="3"
                    Style="{StaticResource DeleteButtonStyle}"
                    Content="삭제"
                    Command="{Binding DataContext.RemoveTodoCommand,
                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
